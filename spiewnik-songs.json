---
permalink: /spiewnik-viribus-unitis-1883/songs.json
sitemap: false
indexing: false
layout: null
---
{%- comment -%}
  dane śpiewnika dla aplikacji offline; jedyne źródło prawdy to nagłówki pieśni
  w spiewnik/*.md — kolejność jak na stronie spisu: oficjalne, potem towarzyskie
{%- endcomment -%}
{%- assign wszystkie = site.pages | where: "song", true -%}
{%- assign oficjalne = wszystkie | where: "section", "oficjalne" | sort: "order" -%}
{%- assign towarzyskie = wszystkie | where: "section", "towarzyskie" | sort: "order" -%}
{%- assign piesni = oficjalne | concat: towarzyskie -%}
{
  "generated": {{ site.time | date: '%s' }},
  "songs": [
{%- for piesn in piesni %}
    {
      "url": {{ piesn.url | relative_url | jsonify }},
      "title": {{ piesn.title | jsonify }},
      "section": {{ piesn.section | jsonify }},
      "order": {{ piesn.order | jsonify }},
      "lyrics": {{ piesn.lyrics | jsonify }},
      "recordings": [{% for nagranie in piesn.recordings %}{"src": {{ nagranie.src | jsonify }}, "note": {{ nagranie.note | jsonify }}}{% unless forloop.last %}, {% endunless %}{% endfor %}],
      "scores": [{% for nuty in piesn.scores %}{{ nuty | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
      "pdf": {{ piesn.pdf | jsonify }},
      "archiwalia": {{ piesn.archiwalia | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ]
}
